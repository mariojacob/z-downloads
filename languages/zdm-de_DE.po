#: templates/admin_menu_help.php:143 templates/admin_menu_ziparchive.php:647
#: templates/admin_premium.php:18
msgid "Download statistics"
msgstr "Downloadstatistik"

#: inc/postbox_premium_info.php:18 templates/admin_premium.php:19
msgid "Capture and analyze the download frequency of your files."
msgstr "Erfassen und analysieren Sie die Download-Häufigkeit Ihrer Dateien."

#: inc/postbox_premium_info.php:24
msgid "Unlimited files in ZIPs"
msgstr "Unbegrenzte Anzahl an Dateien in ZIP-Dateien"

#: inc/postbox_premium_info.php:25 templates/admin_premium.php:85
msgid ""
"In the Premium version, you can pack an unlimited number of files into ZIP "
"downloads. This lifts the limitation of the free version, which only allows "
"5 files per ZIP."
msgstr ""
"In der Premium-Version können Sie unbegrenzt viele Dateien in ZIP-Downloads "
"packen. Dies hebt die Beschränkung der kostenlosen Version auf, in der nur 5 "
"Dateien pro ZIP möglich sind."

#: inc/postbox_premium_info.php:26 templates/admin_premium.php:86
msgid "5 files"
msgstr "5 Dateien"

#: inc/postbox_premium_info.php:27 templates/admin_premium.php:87
msgid "Unlimited"
msgstr "Unlimitiert"

#: inc/postbox_premium_info.php:31 templates/admin_premium.php:92
msgid "External downloads"
msgstr "Externe Downloads"

#: inc/postbox_premium_info.php:32 templates/admin_premium.php:93
msgid "Seamlessly integrates external files for download on your site."
msgstr "Integriert externe Dateien nahtlos zum Download auf Ihrer Website."

#: inc/postbox_premium_info.php:38 templates/admin_premium.php:100
msgid "Advanced statistics"
msgstr "Erweiterte Statistik"

#: inc/postbox_premium_info.php:39 templates/admin_premium.php:101
msgid ""
"Utilize advanced statistics to gain deeper insights into download trends and "
"user behavior. Exclusive for Premium users."
msgstr ""
"Nutzen Sie die erweiterte Statistik, um tiefere Einblicke in Download-Trends "
"und Nutzerverhalten zu erhalten. Exklusiv für Premium-Nutzer."

